#!/usr/bin/env bash
set -Eeuo pipefail
root=/srv/vaultwarden
bucket=${backup_bucket_name}
work=/var/lib/vaultwarden-restore
usage() { echo "usage: vw-restore list|latest|TIMESTAMP" >&2; exit 2; }
[[ $# -eq 1 ]] || usage
if [[ "$1" == list ]]; then
  yc storage s3api list-objects --bucket "$bucket" --prefix vaultwarden/backups/ --format json |
    jq -r '.contents[]?.key // empty'
  exit 0
fi
mkdir -p "$work"
if [[ "$1" == latest ]]; then
  timestamp="$(
    yc storage s3api list-objects --bucket "$bucket" --prefix vaultwarden/backups/ --format json |
      jq -r '[.contents[]?.key | select(test("^vaultwarden/backups/[^/]+/vaultwarden-.+\\.tar\\.gz$")) | capture("^vaultwarden/backups/(?<timestamp>[^/]+)/vaultwarden-.+\\.tar\\.gz$") | .timestamp] | sort | last // empty'
  )"
  [[ -n "$timestamp" ]] || { echo "no backups found" >&2; exit 1; }
else
  timestamp="$1"
fi
name="vaultwarden-$timestamp.tar.gz"
archive="$work/$name"
checksum="$archive.sha256"
prefix="s3://$bucket/vaultwarden/backups/$timestamp"
yc storage s3 cp "$prefix/$name" "$archive"
yc storage s3 cp "$prefix/$name.sha256" "$checksum"
expected="$(awk '{print $1}' "$checksum")"
actual="$(sha256sum "$archive" | awk '{print $1}')"
[[ "$actual" == "$expected" ]] || { echo "checksum mismatch" >&2; exit 1; }
tar -C "$root" -czf "$root/vw-data.before-restore-$(date -u +%Y-%m-%dT%H-%M-%S).tar.gz" vw-data
container_id="$(cd /opt/vaultwarden && docker compose ps -q vaultwarden 2>/dev/null || true)"
[[ -z "$container_id" ]] || (cd /opt/vaultwarden && docker compose stop vaultwarden)
mv "$root/vw-data" "$root/vw-data.before-restore-$timestamp"
tar -C "$root" -xzf "$archive"
[[ -z "$container_id" ]] || (cd /opt/vaultwarden && docker compose up -d vaultwarden)
