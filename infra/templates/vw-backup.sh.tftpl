#!/usr/bin/env bash
set -Eeuo pipefail
root=/srv/vaultwarden
work=/var/lib/vaultwarden-backups
bucket=${backup_bucket_name}
timestamp="$(date -u +%Y-%m-%dT%H-%M-%S)"
name="vaultwarden-$timestamp.tar.gz"
archive="$work/$name"
checksum="$archive.sha256"
stopped=false
cleanup() { [[ "$stopped" == true ]] && (cd /opt/vaultwarden && docker compose start vaultwarden) || true; }
trap cleanup EXIT
mkdir -p "$work"
exec 9>"$work/backup.lock"
flock -n 9 || { echo "backup already running" >&2; exit 1; }
(cd /opt/vaultwarden && docker compose stop vaultwarden)
stopped=true
tar -C "$root" -czf "$archive" vw-data
(cd /opt/vaultwarden && docker compose start vaultwarden)
stopped=false
sha256sum "$archive" > "$checksum"
sha256sum -c "$checksum"
prefix="s3://$bucket/vaultwarden/backups/$timestamp"
yc storage s3 cp "$archive" "$prefix/$(basename "$archive")"
yc storage s3 cp "$checksum" "$prefix/$(basename "$checksum")"
find "$work" -maxdepth 1 -type f \( -name '*.tar.gz' -o -name '*.sha256' \) -printf '%T@ %p\n' | sort -nr | awk 'NR > ${local_backup_keep} { print $2 }' | xargs -r rm -f
