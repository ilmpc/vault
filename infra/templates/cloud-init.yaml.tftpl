#cloud-config
package_update: true
packages: [docker.io, docker-compose-v2, sqlite3, jq, curl, util-linux]
write_files:
  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {"registry-mirrors":["${docker_registry_mirror}"]}
  - path: /opt/vaultwarden/compose.yaml
    permissions: '0644'
    content: |
      ${replace(compose, "\n", "\n      ")}
  - path: /opt/vaultwarden/Caddyfile
    permissions: '0644'
    content: |
      ${replace(caddyfile, "\n", "\n      ")}
  - path: /usr/local/sbin/vw-backup
    permissions: '0750'
    content: |
      ${replace(backup_script, "\n", "\n      ")}
  - path: /usr/local/sbin/vw-restore
    permissions: '0750'
    content: |
      ${replace(restore_script, "\n", "\n      ")}
  - path: /etc/systemd/system/vw-backup.service
    permissions: '0644'
    content: |
      ${replace(backup_service, "\n", "\n      ")}
  - path: /etc/systemd/system/vw-backup.timer
    permissions: '0644'
    content: |
      ${replace(backup_timer, "\n", "\n      ")}
  - path: /etc/systemd/system/vaultwarden-compose.service
    permissions: '0644'
    content: |
      ${replace(compose_service, "\n", "\n      ")}
runcmd:
  - |
    set -eu
    export HOME=/root
    curl -fsSL https://storage.yandexcloud.net/yandexcloud-yc/install.sh | bash
    install -m 0755 /root/yandex-cloud/bin/yc /usr/local/bin/yc
    yc config profile create vaultwarden || true
    yc config set cloud-id ${yc_cloud_id}
    yc config set folder-id ${yc_folder_id}
    printf '%s\n' 'PasswordAuthentication no' 'PermitRootLogin no' 'GatewayPorts no' > /etc/ssh/sshd_config.d/99-vaultwarden.conf
    systemctl reload ssh || systemctl reload sshd || true
    mkdir -p /srv/vaultwarden /opt/vaultwarden /var/lib/vaultwarden-backups
    mkdir -p /srv/vaultwarden/vw-data /srv/vaultwarden/caddy-data /srv/vaultwarden/caddy-config
    if [ ! -f /opt/vaultwarden/.env ]; then
      admin_token=$(openssl rand -base64 48 | tr -d '\n')
      {
        printf '%s\n' 'VAULTWARDEN_IMAGE=${vaultwarden_image}'
        printf '%s\n' 'CADDY_IMAGE=${caddy_image}'
        printf '%s\n' 'DOMAIN=https://${domain_name}'
        printf '%s\n' 'SIGNUPS_ALLOWED=false'
        printf 'ADMIN_TOKEN=%s\n' "$admin_token"
      } > /opt/vaultwarden/.env
    fi
    systemctl daemon-reload
    systemctl restart docker
    if [ ! -f /srv/vaultwarden/vw-data/db.sqlite3 ]; then
      bash /usr/local/sbin/vw-restore latest || echo "No backup found; starting a fresh Vaultwarden"
    fi
    systemctl enable --now vw-backup.timer
    systemctl enable --now vaultwarden-compose.service || true
